{
  "name": "@askgina/os-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The Workflow SDK's Postgres World with payload encryption switched on: one wrapped data key per run.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askgina/os.git",
    "directory": "packages/world"
  },
  "exports": {
    ".": "./src/index.ts",
    "./target": "./src/target.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./target": {
        "types": "./dist/target.d.ts",
        "default": "./dist/target.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@askgina/os-keys": "workspace:*",
    "@workflow/world": "5.2.0",
    "@workflow/world-postgres": "5.2.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@askgina/os-testkit": "workspace:*",
    "@hono/node-server": "2.1.8",
    "@types/pg": "8.23.1",
    "@workflow/world-testing": "5.1.0",
    "hono": "4.13.18",
    "workflow": "5.5.0"
  }
}
