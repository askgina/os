# Public edge. The server's public listener never mounts the Workflow delivery routes; this
# proxy refuses them as well, so a mistake in one place is not enough to expose them.
{
	admin off
}

# Plain HTTP on :8080 by default. compose.tls.yaml sets a host name here instead, and Caddy then
# obtains and renews certificates for it.
{$SITE_ADDRESS:http://:8080} {
	@workflow path /.well-known/workflow /.well-known/workflow/*
	respond @workflow 404

	# The server sets its own Content-Security-Policy; these headers do not overlap with it.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# Every server replica: the addresses `server` resolves to, looked up again every second, so
	# a replica that starts or stops is seen at once; one replica is one address. A request that
	# cannot reach the replica it picked tries another for up to 10 seconds. Caddy runs no active
	# health checks for dynamic upstreams; Compose and Kubernetes ask `/readyz` instead.
	reverse_proxy {
		dynamic a server 3000 {
			refresh 1s
		}
		lb_try_duration 10s
		transport http {
			dial_timeout 2s
		}
	}
}
