# Agent gateway. Agent containers live on an internal network whose only reachable host is this
# proxy, and it forwards nothing but the MCP endpoint. The server checks the Host header against
# the public origin, so the gateway presents that host.
{
	admin off
	auto_https off
}

:80 {
	@mcp path /mcp
	handle @mcp {
		# Every server replica, as on the public edge (deploy/Caddyfile).
		reverse_proxy {
			dynamic a server 3000 {
				refresh 1s
			}
			lb_try_duration 10s
			transport http {
				dial_timeout 2s
			}
			header_up Host {$PUBLIC_HOST}
		}
	}
	handle {
		respond 404
	}
}
