# Settings for a split deployment: the signer and the confirmation page on one host, the
# control plane on another. Copy this file to `.env` beside the Compose file on EACH host and
# keep only that host's part. See deploy/README.md, "Running the signer on its own host".
# Every other setting of the single-host stack (.env.example at the repository root) still
# applies to the host that runs the service it belongs to.

# --- Both hosts: the same three values ---------------------------------------------------

# The name people's passkeys are bound to. It cannot change later.
OS_HOSTNAME=os.example.com
# Where people reach the control plane (served by the control host).
PUBLIC_ORIGIN=https://os.example.com
# Where people approve (served by the signer host). A different host name on purpose.
APPROVE_ORIGIN=https://approve.os.example.com

# --- The signer host (deploy/split/signer.compose.yaml) ----------------------------------

# The private address the control host reaches the signer on. Never a public address.
SIGNER_BIND_ADDRESS=10.0.0.2
# The directory holding this host's certificates and keys from make-peer-certs.sh.
SIGNER_HOST_FILES=/root/os-peer

# --- The control host (deploy/split/control.compose.yaml) --------------------------------

# The DNS name in the signer's certificate. A name, not an IP address: the certificate names
# DNS names only, and the TLS client refuses an address.
SIGNER_HOSTNAME=signer.os.internal
# The directory holding the files copied from the signer host: the control certificate and key,
# the signer's certificate, and the request secret.
CONTROL_HOST_FILES=/root/os-import
# What the members page shows an operator to run on the signer's host. The default suits a
# signer host started with deploy/split/signer.compose.yaml.
# SIGNER_ADMIN_COMMAND=docker compose -f deploy/split/signer.compose.yaml exec signer node src/admin.ts
