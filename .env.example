# Copy to .env and change what you need. Secrets are not set here: `init` generates them.

# The exact address people open in the browser; passkeys are bound to its host name.
PUBLIC_ORIGIN=http://localhost:8080
# The host name part of PUBLIC_ORIGIN, without port; with compose.tls.yaml it is also the site Caddy gets a certificate for.
OS_HOSTNAME=localhost
# The host and port part of PUBLIC_ORIGIN, which the agent gateway presents to the server.
PUBLIC_HOST=localhost:8080
# The port on 127.0.0.1 where the stack is published without TLS.
HTTP_PORT=8080
# The origin of the signer's confirmation page, the only place people approve with their passkeys:
# a host under OS_HOSTNAME or another port on it, never PUBLIC_ORIGIN. Required with
# compose.tls.yaml. Changing it later needs no new passkeys (the RP ID stays OS_HOSTNAME), but
# approvals made on the old origin and not yet acted on are refused: see deploy/README.md.
APPROVE_ORIGIN=http://localhost:8081
# The port on 127.0.0.1 where the confirmation page is published without TLS.
APPROVE_HTTP_PORT=8081
# With compose.tls.yaml and APPROVE_ORIGIN on another port of OS_HOSTNAME: that port.
APPROVE_TLS_PORT=8443
# Optional address that receives a signed POST with identifiers only (no amount, recipient or
# memo) when an approval waits and when a mandate is used. Retried until accepted. The signing
# secret is the file notify-webhook-secret in the server's secrets volume: see deploy/README.md.
NOTIFY_WEBHOOK_URL=
# 1 lets people turn on Web Push notifications. Browsers' push services (Apple, Google, Mozilla,
# Microsoft) then see when and how often a device is notified, never what about. Off unless set.
WEB_PUSH_ENABLED=
# Contact for push services, mailto: or https:. Needed only when PUBLIC_ORIGIN is not https.
WEB_PUSH_SUBJECT=
# Comma-separated host suffixes a push subscription must be under. Empty keeps the built-in list.
WEB_PUSH_ENDPOINT_HOSTS=
# The longest life of a mandate, in seconds (3600 to 2592000; default 604800, seven days). One
# value for both checks: the signer's SIGNER_MAX_MANDATE_SECONDS, which decides, and the server's
# MANDATE_MAX_SECONDS, which refuses a longer draft before anyone is asked.
MANDATE_MAX_SECONDS=604800
# How many live mandates one wallet may hold (1 to 64; default 16).
SIGNER_MAX_LIVE_MANDATES_PER_WALLET=16
# How long after its first signature a stuck transaction may be repriced (same payment, same
# nonce, a higher fee within the approved ceiling) with no person asked, in seconds (0 to 604800;
# default 86400, one day; 0 turns it off). After that a person cancels it with a passkey.
SIGNER_REPRICE_WINDOW_SECONDS=86400
# The most signatures one approval may produce, the first included (2 to 64; default 16).
SIGNER_MAX_TX_ATTEMPTS=16
# Chains and their RPC URLs are not set here: edit deploy/chains.json to add real chains.
